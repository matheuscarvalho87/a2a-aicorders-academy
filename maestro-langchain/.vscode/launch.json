{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Maestro · HTTP pronto",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/maestro.py",
      "args": ["--transport", "http"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Maestro · A2A exercício",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/maestro.py",
      "args": ["--transport", "a2a"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Maestro · A2A referência",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/maestro.py",
      "args": ["--transport", "a2a", "--implementation", "reference"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
